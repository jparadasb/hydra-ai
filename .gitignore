# Rust
/worker/target/
# worker-app is excluded from the workspace, so it has its own target/ + Tauri-generated dirs.
/worker/crates/worker-app/target/
/worker/crates/worker-app/gen/
**/*.rs.bk

# Elixir
/coordinator/_build/
/coordinator/deps/
/coordinator/*.ez
erl_crash.dump

# SQLite databases
/coordinator/*.db
/coordinator/*.db-shm
/coordinator/*.db-wal

# Landing page build (Tailwind). The built CSS is committed so the coordinator's Docker image
# (which runs no npm) can bundle it into priv/site; regenerate with `npm run build:site`.
/node_modules/

# Local secrets
.env

# Local worker state (never commit secrets)
*.vault.bin
.hydra-vault.bin
.hydra-usage.json
/worker/hydra-worker-new
/worker/hydra-worker-*

# Nightly pg_dump output from the compose stack's pg-backup service. Real data — never commit.
/backups/

# Per-user coding-agent state. `.claude/settings.local.json` was untracked only because nobody
# had run `git add` on it yet. `.serena/project.yml` stays tracked on purpose — it is shared
# project config (which languages to index), and `.serena/.gitignore` already excludes the
# cache and the per-user local override.
.claude/
