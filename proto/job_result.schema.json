{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hydra-ai/proto/job_result.schema.json",
  "title": "JobResult",
  "description": "Worker -> coordinator. Normalized result of a leased job.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "status"
  ],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "lease_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "ok",
        "rejected",
        "error"
      ]
    },
    "reason": {
      "type": "string",
      "description": "Set when status is rejected/error (e.g. privacy_violation, limit_exceeded)."
    },
    "output": {
      "type": "object",
      "description": "Capability-specific normalized output. Deliberately open: `content` and `tool_calls` are what the OpenAI adapter reads, and anything a capability produces lives alongside them.",
      "properties": {
        "artifacts": {
          "type": "array",
          "description": "Discrete products of the job, for a caller that wants more than one string back. Inline `content` is bounded by the coordinator's result size cap; `uri` is reserved for a future artifact store, so a producer can grow into one without a schema change.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "name"
            ],
            "properties": {
              "type": {
                "enum": [
                  "patch",
                  "file",
                  "json",
                  "text",
                  "log"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255
              },
              "mime_type": {
                "type": "string"
              },
              "bytes": {
                "type": "integer",
                "minimum": 0
              },
              "content": {
                "type": "string",
                "description": "Inline. Omitted when `uri` is set."
              },
              "uri": {
                "type": "string",
                "description": "Reserved; no artifact store exists yet."
              },
              "sha256": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "input_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "output_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "latency_ms": {
          "type": "number",
          "minimum": 0
        },
        "total_tokens": {
          "type": "integer",
          "minimum": 0
        },
        "reasoning_tokens": {
          "type": "integer",
          "minimum": 0,
          "description": "Thinking tokens, where the backend reports them separately from output."
        }
      }
    }
  }
}
