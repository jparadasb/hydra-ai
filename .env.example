# Copy to .env and fill in. Do NOT commit .env.

# Postgres password (used by the postgres service and the coordinator's DATABASE_URL).
POSTGRES_PASSWORD=change-me

# Phoenix endpoint signing key. Generate a 64+ byte secret:
#   mix phx.gen.secret      (or: openssl rand -base64 48)
SECRET_KEY_BASE=replace-with-a-long-random-secret

# Cloudflare Tunnel token from the Zero Trust dashboard (Networks -> Tunnels -> your tunnel).
# In the dashboard, route your public hostname to the service http://coordinator:4000.
TUNNEL_TOKEN=replace-with-your-cloudflare-tunnel-token

# Public hostname this coordinator is reached on, behind the tunnel. Also constrains
# LiveView/socket origin checking — left unset it stays at the "localhost" default, which is
# why the /admin LiveView fails through a tunnel.
PHX_HOST=hydra.example.com

# ---- Authentication: ON by default ---------------------------------------------------------
# These used to be commented out, so following the quickstart produced a coordinator that was
# publicly reachable through the tunnel with no worker auth and no gateway-key requirement.
# Turn them off deliberately if you know why, rather than by default.

# Reject any worker that does not present an Ed25519 device key. Each worker derives a stable
# machine worker_id and a local device key (the private half never leaves the worker); the
# coordinator pins the public key on first contact (trust-on-first-use).
HYDRA_REQUIRE_DEVICE_AUTH=true

# Optional shared join token (fallback auth for workers that present no device key). Generate:
# openssl rand -hex 32
# HYDRA_JOIN_TOKEN=replace-with-a-long-random-secret

# Optional: DB connection pool size (default 10).
# POOL_SIZE=10

# ---- OpenAI-compatible front-door (Coordinator.ApiRouter) ---------------------------------
# Legacy master gateway key (single shared bearer). Optional if you issue keys via /admin.
# HYDRA_API_TOKEN=replace-with-a-long-random-secret
# Routing capability for chat requests; must match a capability connected workers advertise.
# HYDRA_API_CAPABILITY=chat
# Require a valid bearer even without a master key, so admin-issued keys alone gate the door.
# On by default: an open front door on a public tunnel is an open door to your GPUs.
HYDRA_REQUIRE_API_TOKEN=true

# ---- Front-door ceilings (Coordinator.RateLimiter) ------------------------------------------
# Per gateway key, or per peer IP when the door is open. 0 disables either.
# HYDRA_RATE_LIMIT_PER_MINUTE=120
# HYDRA_MAX_CONCURRENT_PER_KEY=8
# Largest accepted request body; it is persisted verbatim into jobs.payload.
# HYDRA_MAX_BODY_BYTES=2000000

# ---- Prompt retention (Coordinator.JobRetention) --------------------------------------------
# How long a completed job keeps the prompt and completion before both are replaced with a
# size-only summary, and how long the text-free row survives. 0 disables that stage.
# HYDRA_JOB_REDACT_AFTER_HOURS=24
# HYDRA_JOB_RETENTION_DAYS=30

# ---- Database -------------------------------------------------------------------------------
# Require TLS to Postgres. Leave false for the bundled compose stack (same Docker network);
# set true for a managed database reached over a network you do not control.
# DATABASE_SSL=false
# SQLite only (DB_ADAPTER=sqlite3): where the file lives. Single node only.
# DATABASE_PATH=/var/lib/hydra/coordinator.db
# Nightly pg_dump retention, in days (pg-backup service).
# BACKUP_RETENTION_DAYS=14

# ---- Clustering (more than one coordinator replica) -----------------------------------------
# Requires Postgres: a SQLite file cannot be shared between replicas, and the coordinator
# refuses to start clustered on it. All replicas must share RELEASE_COOKIE.
# HYDRA_CLUSTER_SERVICE=coordinator-headless
# HYDRA_CLUSTER_NODE_BASENAME=coordinator
# RELEASE_DISTRIBUTION=name
# RELEASE_NODE=coordinator@10.0.0.1
# RELEASE_COOKIE=replace-with-a-long-random-secret

# ---- Worker logging -------------------------------------------------------------------------
# HYDRA_LOG=info
# HYDRA_LOG_FORMAT=json

# ---- Admin console (/admin): issue API keys + Oban dashboard ------------------------------
# Protected by GitHub OAuth in prod. Register a GitHub OAuth app whose Authorization callback
# URL is <HYDRA_ADMIN_BASE_URL>/auth/github/callback.
# HYDRA_ADMIN_BASE_URL=https://coordinator.example.com
# HYDRA_GITHUB_CLIENT_ID=your-oauth-app-client-id
# HYDRA_GITHUB_CLIENT_SECRET=your-oauth-app-client-secret
# Comma-separated GitHub logins allowed into /admin (empty => nobody).
# HYDRA_ADMIN_GITHUB_USERS=jparadas
# Set to "false" to open /admin without login (never on a public tunnel).
# HYDRA_ADMIN_AUTH=false
